{
  "name": "confess-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "VITE_API_BASE=https://api.test node --test --experimental-strip-types --no-warnings src/lib/*.test.ts",
    "typecheck": "tsc -b",
    "android:sync": "python3 scripts/android_sync.py",
    "android:check": "python3 scripts/android_sync.py --check"
  },
  "dependencies": {
    "react": "19.2.9",
    "react-dom": "19.2.9"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "5.2.0",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  }
}
