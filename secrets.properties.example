# Copy to secrets.properties (git-ignored) and fill in. Values here end up in the APK —
# never put server-side secrets (bot tokens, DB passwords, API secrets) in this file.

# Google Sign-In: OAuth *Web* client id (the server verifies tokens against it)
WEB_CLIENT_ID=
# API base URL, ending with /
SERVER_URL=https://confess.api.example.com/
BACKUP_URL=
# Sent as x-api-key (identifies the app; not a secret)
CLIENT_API=

# Security — see SECURITY.md
CERT_PINS=sha256/PRIMARY_PIN=,sha256/BACKUP_PIN=
DEBUG_ALLOW_PROXY=false
CLOUD_PROJECT_NUMBER=0
SIGNING_CERT_SHA256=

# GIPHY API key (GIF picker) — developers.giphy.com → Create an App → API
GIPHY_API_KEY=
