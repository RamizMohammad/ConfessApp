# Confess web app — build-time settings (Vite). Copy to `.env` and fill in.
# The same .env is read by `npm run dev/build` and by `docker compose`.
# EVERYTHING here ends up in the JavaScript sent to browsers, so it must be PUBLIC:
# never put a secret, API key or password in this file. Secrets live only on the server.

# The API (no trailing slash). REQUIRED — the build stops without it.
# e.g. https://your-api.example (http:// only for localhost while testing)
VITE_API_BASE=

# Google OAuth *web* client ID (public by design). Its "Authorized redirect URIs" must include
#   https://app.confess.mohammadramiz.in/auth/google
# and the same ID must be in the server's GOOGLE_CLIENT_ID list.
VITE_GOOGLE_CLIENT_ID=

# Cloudflare Turnstile SITE key (public). The SECRET key goes only in the server's TURNSTILE_SECRET.
# Blank = no bot check (server TURNSTILE_MODE must then be off).
VITE_TURNSTILE_SITE_KEY=

# Shown to Android visitors
VITE_PLAY_STORE_URL=https://play.google.com/store/apps/details?id=in.mohammad.ramiz.confess

# Website (guidelines, privacy, delete account)
VITE_WEBSITE_URL=https://confess.mohammadramiz.in
