<?xml version="1.0" encoding="utf-8"?>
<!--
    Component styles (DESIGN.md "Components"). Applied as theme defaults in
    themes.xml, so plain <MaterialButton>, <TextInputLayout>, <Chip>, etc.
    pick them up automatically. Variants are applied with style="@style/…".
-->
<resources>

    <!-- ── Shapes ─────────────────────────────────────────────────────── -->
    <style name="ShapeAppearance.Confess.Pill" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>
    <style name="ShapeAppearance.Confess.Input" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_input</item>
    </style>
    <!-- GIFs (picker tiles, cards, responses): softly rounded. -->
    <style name="ShapeAppearance.Confess.Gif" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>

    <style name="ShapeAppearance.Confess.Card" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_card</item>
    </style>
    <style name="ShapeAppearance.Confess.Sheet" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">@dimen/radius_sheet</item>
        <item name="cornerSizeTopRight">@dimen/radius_sheet</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>
    <style name="ShapeAppearance.Confess.Circle" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <!-- ── Buttons ────────────────────────────────────────────────────── -->

    <!-- Primary: amber pill, ink text. The one amber thing on a screen. -->
    <style name="Widget.Confess.Button" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/sl_button_primary_bg</item>
        <item name="android:textColor">@color/sl_button_primary_text</item>
        <item name="iconTint">@color/sl_button_primary_text</item>
        <item name="android:textAppearance">@style/TextAppearance.Confess.Button</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Confess.Pill</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">@dimen/space_lg</item>
        <item name="android:paddingEnd">@dimen/space_lg</item>
        <item name="iconGravity">textEnd</item>
        <item name="iconPadding">@dimen/space_sm</item>
        <item name="iconSize">@dimen/icon_size_sm</item>
        <item name="rippleColor">@color/amber_pressed</item>
        <item name="elevation">0dp</item>
    </style>

    <!-- Light: paper pill (e.g. "Continue with Google"). -->
    <style name="Widget.Confess.Button.Light">
        <item name="backgroundTint">@color/paper</item>
        <item name="android:textColor">@color/paper_ink</item>
        <item name="iconTint">@null</item>
        <item name="iconGravity">textStart</item>
        <item name="iconSize">@dimen/icon_size</item>
        <item name="iconPadding">@dimen/space_12</item>
        <item name="rippleColor">@color/paper_rule</item>
    </style>

    <!-- Outlined: hairline pill on dark (e.g. "Use biometrics"). -->
    <style name="Widget.Confess.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textColor">@color/sl_text_primary</item>
        <item name="iconTint">@color/text_primary</item>
        <item name="strokeColor">@color/hairline</item>
        <item name="strokeWidth">@dimen/hairline</item>
        <item name="backgroundTint">@color/transparent</item>
        <item name="android:textAppearance">@style/TextAppearance.Confess.Button</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Confess.Pill</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">@dimen/space_12</item>
        <item name="iconSize">@dimen/icon_size</item>
        <item name="rippleColor">@color/sl_ripple_dark</item>
    </style>

    <!-- Segment: one option in a GlideToggleGroup — bare (no fill, no outline). The group draws the
         one rounded track and the amber pill that glides to the chosen option, and tints the labels;
         tighter side padding so three fit on a phone. -->
    <style name="Widget.Confess.Button.Segment" parent="Widget.Confess.Button.Outlined">
        <item name="backgroundTint">@color/sl_segment_bg</item>
        <item name="android:textColor">@color/sl_segment_text</item>
        <item name="strokeWidth">0dp</item>
        <item name="rippleColor">@color/transparent</item>         <!-- the gliding pill is the feedback -->
        <item name="android:stateListAnimator">@null</item>
        <item name="android:paddingStart">@dimen/space_xs</item>
        <item name="android:paddingEnd">@dimen/space_xs</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <!-- Danger: brick outline (delete account, sign out). -->
    <style name="Widget.Confess.Button.Danger" parent="Widget.Confess.Button.Outlined">
        <item name="android:textColor">@color/brick</item>
        <item name="iconTint">@color/brick</item>
        <item name="strokeColor">@color/brick</item>
    </style>

    <!-- Ghost: text-only, secondary color (Cancel, Forgot password?). -->
    <style name="Widget.Confess.Button.Ghost" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="iconTint">@color/text_secondary</item>
        <item name="android:textAppearance">@style/TextAppearance.Confess.Label</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Confess.Pill</item>
        <item name="rippleColor">@color/sl_ripple_dark</item>
        <item name="android:minHeight">@dimen/touch_target</item>
    </style>

    <!-- Ghost in amber (inline links: "Review guidelines →"). -->
    <style name="Widget.Confess.Button.Link" parent="Widget.Confess.Button.Ghost">
        <item name="android:textColor">@color/amber</item>
        <item name="iconTint">@color/amber</item>
        <item name="iconGravity">textEnd</item>
    </style>

    <!-- Round icon button (toolbar back / close / overflow). -->
    <style name="Widget.Confess.IconButton" parent="Widget.Material3.Button.IconButton">
        <item name="iconTint">@color/text_primary</item>
        <item name="iconSize">@dimen/icon_size</item>
        <item name="rippleColor">@color/sl_ripple_dark</item>
        <item name="android:minWidth">@dimen/touch_target</item>
        <item name="android:minHeight">@dimen/touch_target</item>
        <!-- Icon-only: exactly 12 + 24 + 12 = 48dp, no hidden text padding or insets
             (otherwise each button grew to ~80dp and toolbars looked gappy). -->
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:paddingLeft">12dp</item>
        <item name="android:paddingRight">12dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="iconPadding">0dp</item>
        <item name="iconGravity">textStart</item>
    </style>

    <!-- ── Text fields ────────────────────────────────────────────────── -->
    <style name="Widget.Confess.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundMode">outline</item>
        <item name="boxBackgroundColor">@color/surface_raised</item>
        <item name="boxStrokeColor">@color/sl_input_stroke</item>
        <item name="boxStrokeWidth">@dimen/hairline</item>
        <item name="boxStrokeWidthFocused">@dimen/hairline</item>
        <item name="boxStrokeErrorColor">@color/brick</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Confess.Input</item>
        <item name="hintEnabled">false</item>
        <item name="android:textColorHint">@color/text_muted</item>
        <item name="placeholderTextColor">@color/text_muted</item>
        <item name="counterTextAppearance">@style/TextAppearance.Confess.Meta</item>
        <item name="counterTextColor">@color/text_muted</item>
        <item name="counterOverflowTextColor">@color/brick</item>
        <item name="helperTextTextAppearance">@style/TextAppearance.Confess.Meta</item>
        <item name="helperTextTextColor">@color/text_secondary</item>
        <item name="errorTextAppearance">@style/TextAppearance.Confess.Meta</item>
        <item name="errorTextColor">@color/brick</item>
        <item name="errorIconTint">@color/brick</item>
        <item name="endIconTint">@color/text_secondary</item>
        <item name="startIconTint">@color/text_secondary</item>
        <item name="materialThemeOverlay">@style/ThemeOverlay.Confess.TextInput</item>
    </style>

    <style name="ThemeOverlay.Confess.TextInput" parent="ThemeOverlay.Material3.TextInputEditText.OutlinedBox">
        <item name="editTextStyle">@style/Widget.Confess.EditText</item>
    </style>

    <style name="Widget.Confess.EditText" parent="Widget.Material3.TextInputEditText.OutlinedBox">
        <item name="android:textAppearance">@style/TextAppearance.Confess.Body</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:paddingTop">16dp</item>
        <item name="android:paddingBottom">16dp</item>
    </style>

    <!-- ── Chips ──────────────────────────────────────────────────────── -->
    <style name="Widget.Confess.Chip" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/sl_chip_bg</item>
        <item name="chipStrokeColor">@color/sl_chip_stroke</item>
        <item name="chipStrokeWidth">@dimen/hairline</item>
        <item name="android:textColor">@color/sl_chip_text</item>
        <item name="android:textAppearance">@style/TextAppearance.Confess.Meta</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Confess.Pill</item>
        <item name="checkedIconVisible">false</item>
        <item name="chipIconVisible">false</item>
        <item name="rippleColor">@color/sl_ripple_dark</item>
        <item name="chipMinHeight">36dp</item>
        <item name="chipStartPadding">@dimen/space_12</item>
        <item name="chipEndPadding">@dimen/space_12</item>
        <item name="ensureMinTouchTargetSize">true</item>
    </style>

    <!-- ── Selection controls ─────────────────────────────────────────── -->
    <style name="Widget.Confess.Switch" parent="Widget.Material3.CompoundButton.MaterialSwitch">
        <item name="trackTint">@color/sl_switch_track</item>
        <item name="thumbTint">@color/sl_switch_thumb</item>
        <item name="trackDecorationTint">@color/transparent</item>
    </style>

    <style name="Widget.Confess.CheckBox" parent="Widget.Material3.CompoundButton.CheckBox">
        <item name="buttonTint">@color/sl_checkbox</item>
        <item name="android:textAppearance">@style/TextAppearance.Confess.BodyMedium</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <!-- Full-width radio row (report reasons). -->
    <style name="Widget.Confess.Radio" parent="Widget.Material3.CompoundButton.RadioButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">@dimen/touch_target</item>
        <item name="buttonTint">@color/sl_checkbox</item>
        <item name="android:paddingStart">@dimen/space_sm</item>
        <item name="android:textAppearance">@style/TextAppearance.Confess.BodyMedium</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <!-- ── Progress ───────────────────────────────────────────────────── -->
    <style name="Widget.Confess.Progress.Circular" parent="Widget.Material3.CircularProgressIndicator">
        <item name="indicatorColor">@color/amber</item>
        <item name="trackColor">@color/transparent</item>
        <item name="indicatorSize">28dp</item>
        <item name="trackThickness">2dp</item>
    </style>

    <style name="Widget.Confess.Progress.Linear" parent="Widget.Material3.LinearProgressIndicator">
        <item name="indicatorColor">@color/amber</item>
        <item name="trackColor">@color/hairline</item>
        <item name="trackThickness">2dp</item>
        <item name="trackCornerRadius">1dp</item>
    </style>

    <!-- ── Snackbar ───────────────────────────────────────────────────── -->
    <style name="Widget.Confess.Snackbar" parent="Widget.Material3.Snackbar">
        <item name="backgroundTint">@color/surface_high</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Confess.Input</item>
    </style>
    <style name="Widget.Confess.Snackbar.Text" parent="Widget.Material3.Snackbar.TextView">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textAppearance">@style/TextAppearance.Confess.BodyMedium</item>
    </style>
    <style name="Widget.Confess.Snackbar.Button" parent="Widget.Material3.Button.TextButton.Snackbar">
        <item name="android:textColor">@color/amber</item>
    </style>

    <!-- ── Sheets + dialogs ───────────────────────────────────────────── -->
    <style name="ThemeOverlay.Confess.BottomSheetDialog" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.Confess.BottomSheet</item>
        <item name="android:navigationBarColor">@color/surface_raised</item>
        <item name="android:windowIsFloating">false</item>
        <item name="enableEdgeToEdge">true</item>
    </style>
    <style name="Widget.Confess.BottomSheet" parent="Widget.Material3.BottomSheet.Modal">
        <item name="backgroundTint">@color/surface_raised</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Confess.Sheet</item>
    </style>

    <style name="ThemeOverlay.Confess.AlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorSurface">@color/surface_raised</item>
        <item name="colorSurfaceContainerHigh">@color/surface_raised</item>
        <item name="materialAlertDialogTitleTextStyle">@style/Confess.DialogTitle</item>
        <item name="materialAlertDialogBodyTextStyle">@style/Confess.DialogBody</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.Confess.Button.Link</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.Confess.Button.Ghost</item>
        <item name="shapeAppearanceCornerExtraLarge">@style/ShapeAppearance.Confess.Card</item>
    </style>
    <style name="Confess.DialogTitle" parent="MaterialAlertDialog.Material3.Title.Text">
        <item name="android:textAppearance">@style/TextAppearance.Confess.HeadlineSmall</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>
    <style name="Confess.DialogBody" parent="MaterialAlertDialog.Material3.Body.Text">
        <item name="android:textAppearance">@style/TextAppearance.Confess.BodyMedium</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <!-- ── Navigation ─────────────────────────────────────────────────── -->
    <style name="Widget.Confess.BottomNavigation" parent="Widget.Material3.BottomNavigationView">
        <item name="backgroundTint">@color/surface_raised</item>
        <item name="itemIconTint">@color/sl_nav_item</item>
        <item name="itemTextColor">@color/sl_nav_item</item>
        <item name="itemTextAppearanceActive">@style/TextAppearance.Confess.MetaSmall</item>
        <item name="itemTextAppearanceInactive">@style/TextAppearance.Confess.MetaSmall</item>
        <item name="itemActiveIndicatorStyle">@null</item>
        <item name="itemRippleColor">@color/sl_ripple_dark</item>
        <item name="labelVisibilityMode">labeled</item>
        <item name="elevation">0dp</item>
    </style>

    <style name="Widget.Confess.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">@color/transparent</item>
        <item name="titleTextAppearance">@style/TextAppearance.Confess.HeadlineSmall</item>
        <item name="titleTextColor">@color/text_primary</item>
        <item name="navigationIconTint">@color/text_primary</item>
    </style>

    <!-- ── Text helpers used directly in layouts ──────────────────────── -->
    <!-- Small caps tag pill: "• ANONYMOUS DOORWAY". -->
    <style name="Confess.Tag" parent="">
        <item name="android:background">@drawable/bg_tag</item>
        <item name="android:paddingStart">@dimen/space_12</item>
        <item name="android:paddingEnd">@dimen/space_12</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">6dp</item>
        <item name="android:textAppearance">@style/TextAppearance.Confess.MetaSmall</item>
        <item name="android:textColor">@color/amber</item>
        <item name="android:drawablePadding">6dp</item>
        <item name="android:gravity">center_vertical</item>
    </style>

    <!-- Section header in lists: "SECURITY", "TODAY". -->
    <style name="Confess.SectionLabel" parent="">
        <item name="android:textAppearance">@style/TextAppearance.Confess.MetaSmall</item>
        <item name="android:textColor">@color/text_muted</item>
        <item name="android:paddingTop">@dimen/space_lg</item>
        <item name="android:paddingBottom">@dimen/space_sm</item>
    </style>

</resources>
