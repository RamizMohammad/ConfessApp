<?xml version="1.0" encoding="utf-8"?>
<!--
    Splash animation (1000 ms, = windowSplashScreenAnimationDuration):
      0–260   Letty settles in
      120–240 she blinks
      260–520 the seal pops — the envelope wobbles
      380–1000 sparkles twinkle around her, one after another
      180–420 the Confess seal swells, then spins off
      380–520 the flap folds up to its hinge
      520–720 the inside of the flap swings up behind the letter
      600–860 the letter rises out of the envelope
      700–800 her eyes turn into a smile
      820–1000 a heart pops out of the letter
-->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:drawable="@drawable/splash_letty">

    <target android:name="letty">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator android:propertyName="rotation" android:valueFrom="0" android:valueTo="-6"
                    android:startOffset="260" android:duration="90" android:interpolator="@android:interpolator/decelerate_quad" />
                <objectAnimator android:propertyName="rotation" android:valueFrom="-6" android:valueTo="4"
                    android:startOffset="350" android:duration="100" android:interpolator="@android:interpolator/accelerate_decelerate" />
                <objectAnimator android:propertyName="rotation" android:valueFrom="4" android:valueTo="0"
                    android:startOffset="450" android:duration="90" android:interpolator="@android:interpolator/decelerate_quad" />
                <objectAnimator android:propertyName="scaleX" android:valueFrom="0.86" android:valueTo="1"
                    android:duration="260" android:interpolator="@android:anim/overshoot_interpolator" />
                <objectAnimator android:propertyName="scaleY" android:valueFrom="0.86" android:valueTo="1"
                    android:duration="260" android:interpolator="@android:anim/overshoot_interpolator" />
            </set>
        </aapt:attr>
    </target>

    <target android:name="seal">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator android:propertyName="scaleX" android:valueFrom="1" android:valueTo="1.2"
                    android:startOffset="180" android:duration="80" />
                <objectAnimator android:propertyName="scaleY" android:valueFrom="1" android:valueTo="1.2"
                    android:startOffset="180" android:duration="80" />
                <objectAnimator android:propertyName="scaleX" android:valueFrom="1.2" android:valueTo="0"
                    android:startOffset="260" android:duration="160" android:interpolator="@android:interpolator/accelerate_quad" />
                <objectAnimator android:propertyName="scaleY" android:valueFrom="1.2" android:valueTo="0"
                    android:startOffset="260" android:duration="160" android:interpolator="@android:interpolator/accelerate_quad" />
                <objectAnimator android:propertyName="rotation" android:valueFrom="0" android:valueTo="70"
                    android:startOffset="260" android:duration="160" />
            </set>
        </aapt:attr>
    </target>

    <target android:name="flap">
        <aapt:attr name="android:animation">
            <objectAnimator android:propertyName="scaleY" android:valueFrom="1" android:valueTo="0"
                android:startOffset="380" android:duration="140" android:interpolator="@android:interpolator/accelerate_quad" />
        </aapt:attr>
    </target>

    <target android:name="flapBack">
        <aapt:attr name="android:animation">
            <objectAnimator android:propertyName="scaleY" android:valueFrom="0" android:valueTo="-1"
                android:startOffset="520" android:duration="200" android:interpolator="@android:anim/overshoot_interpolator" />
        </aapt:attr>
    </target>

    <target android:name="letterCard">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator android:propertyName="fillAlpha" android:valueFrom="0" android:valueTo="1"
                    android:startOffset="600" android:duration="1" />
                <objectAnimator android:propertyName="strokeAlpha" android:valueFrom="0" android:valueTo="1"
                    android:startOffset="600" android:duration="1" />
            </set>
        </aapt:attr>
    </target>

    <target android:name="letterLines">
        <aapt:attr name="android:animation">
            <objectAnimator android:propertyName="strokeAlpha" android:valueFrom="0" android:valueTo="0.35"
                android:startOffset="600" android:duration="1" />
        </aapt:attr>
    </target>

    <target android:name="letter">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator android:propertyName="translateY" android:valueFrom="0" android:valueTo="-21"
                    android:startOffset="600" android:duration="260" android:interpolator="@android:anim/overshoot_interpolator" />
                <objectAnimator android:propertyName="rotation" android:valueFrom="0" android:valueTo="-5"
                    android:startOffset="600" android:duration="150" android:interpolator="@android:interpolator/decelerate_quad" />
                <objectAnimator android:propertyName="rotation" android:valueFrom="-5" android:valueTo="0"
                    android:startOffset="750" android:duration="170" android:interpolator="@android:anim/overshoot_interpolator" />
            </set>
        </aapt:attr>
    </target>

    <target android:name="blink">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator android:propertyName="scaleY" android:valueFrom="1" android:valueTo="0.1"
                    android:startOffset="120" android:duration="60" />
                <objectAnimator android:propertyName="scaleY" android:valueFrom="0.1" android:valueTo="1"
                    android:startOffset="180" android:duration="60" />
            </set>
        </aapt:attr>
    </target>

    <target android:name="eyes">
        <aapt:attr name="android:animation">
            <objectAnimator android:propertyName="fillAlpha" android:valueFrom="1" android:valueTo="0"
                android:startOffset="700" android:duration="60" />
        </aapt:attr>
    </target>

    <target android:name="happy">
        <aapt:attr name="android:animation">
            <objectAnimator android:propertyName="strokeAlpha" android:valueFrom="0" android:valueTo="1"
                android:startOffset="740" android:duration="60" />
        </aapt:attr>
    </target>

    <target android:name="heart">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator android:propertyName="scaleX" android:valueFrom="0" android:valueTo="1"
                    android:startOffset="820" android:duration="180" android:interpolator="@android:anim/overshoot_interpolator" />
                <objectAnimator android:propertyName="scaleY" android:valueFrom="0" android:valueTo="1"
                    android:startOffset="820" android:duration="180" android:interpolator="@android:anim/overshoot_interpolator" />
            </set>
        </aapt:attr>
    </target>
    <target android:name="spark0">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator android:propertyName="scaleX" android:valueFrom="0" android:valueTo="1.1"
                    android:startOffset="380" android:duration="130" android:interpolator="@android:anim/overshoot_interpolator" />
                <objectAnimator android:propertyName="scaleY" android:valueFrom="0" android:valueTo="1.1"
                    android:startOffset="380" android:duration="130" android:interpolator="@android:anim/overshoot_interpolator" />
                <objectAnimator android:propertyName="rotation" android:valueFrom="0" android:valueTo="90"
                    android:startOffset="380" android:duration="330" />
                <objectAnimator android:propertyName="scaleX" android:valueFrom="1.1" android:valueTo="0"
                    android:startOffset="530" android:duration="180" android:interpolator="@android:interpolator/accelerate_quad" />
                <objectAnimator android:propertyName="scaleY" android:valueFrom="1.1" android:valueTo="0"
                    android:startOffset="530" android:duration="180" android:interpolator="@android:interpolator/accelerate_quad" />
            </set>
        </aapt:attr>
    </target>
    <target android:name="spark1">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator android:propertyName="scaleX" android:valueFrom="0" android:valueTo="1.1"
                    android:startOffset="520" android:duration="130" android:interpolator="@android:anim/overshoot_interpolator" />
                <objectAnimator android:propertyName="scaleY" android:valueFrom="0" android:valueTo="1.1"
                    android:startOffset="520" android:duration="130" android:interpolator="@android:anim/overshoot_interpolator" />
                <objectAnimator android:propertyName="rotation" android:valueFrom="0" android:valueTo="90"
                    android:startOffset="520" android:duration="330" />
                <objectAnimator android:propertyName="scaleX" android:valueFrom="1.1" android:valueTo="0"
                    android:startOffset="670" android:duration="180" android:interpolator="@android:interpolator/accelerate_quad" />
                <objectAnimator android:propertyName="scaleY" android:valueFrom="1.1" android:valueTo="0"
                    android:startOffset="670" android:duration="180" android:interpolator="@android:interpolator/accelerate_quad" />
            </set>
        </aapt:attr>
    </target>
    <target android:name="spark2">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator android:propertyName="scaleX" android:valueFrom="0" android:valueTo="1.1"
                    android:startOffset="640" android:duration="130" android:interpolator="@android:anim/overshoot_interpolator" />
                <objectAnimator android:propertyName="scaleY" android:valueFrom="0" android:valueTo="1.1"
                    android:startOffset="640" android:duration="130" android:interpolator="@android:anim/overshoot_interpolator" />
                <objectAnimator android:propertyName="rotation" android:valueFrom="0" android:valueTo="90"
                    android:startOffset="640" android:duration="330" />
                <objectAnimator android:propertyName="scaleX" android:valueFrom="1.1" android:valueTo="0"
                    android:startOffset="790" android:duration="180" android:interpolator="@android:interpolator/accelerate_quad" />
                <objectAnimator android:propertyName="scaleY" android:valueFrom="1.1" android:valueTo="0"
                    android:startOffset="790" android:duration="180" android:interpolator="@android:interpolator/accelerate_quad" />
            </set>
        </aapt:attr>
    </target>
    <target android:name="spark3">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator android:propertyName="scaleX" android:valueFrom="0" android:valueTo="1.1"
                    android:startOffset="670" android:duration="130" android:interpolator="@android:anim/overshoot_interpolator" />
                <objectAnimator android:propertyName="scaleY" android:valueFrom="0" android:valueTo="1.1"
                    android:startOffset="670" android:duration="130" android:interpolator="@android:anim/overshoot_interpolator" />
                <objectAnimator android:propertyName="rotation" android:valueFrom="0" android:valueTo="90"
                    android:startOffset="670" android:duration="330" />
                <objectAnimator android:propertyName="scaleX" android:valueFrom="1.1" android:valueTo="0"
                    android:startOffset="820" android:duration="180" android:interpolator="@android:interpolator/accelerate_quad" />
                <objectAnimator android:propertyName="scaleY" android:valueFrom="1.1" android:valueTo="0"
                    android:startOffset="820" android:duration="180" android:interpolator="@android:interpolator/accelerate_quad" />
            </set>
        </aapt:attr>
    </target>
</animated-vector>
