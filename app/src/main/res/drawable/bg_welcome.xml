<?xml version="1.0" encoding="utf-8"?>
<!-- Ink canvas with a faint candle-glow from the lower half (S1 / S2 backdrop). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/ink" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:centerX="0.5"
                android:centerY="0.62"
                android:endColor="#000F0E13"
                android:gradientRadius="420dp"
                android:startColor="#22E8A04C"
                android:type="radial" />
        </shape>
    </item>
</layer-list>
