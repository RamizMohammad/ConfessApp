<?xml version="1.0" encoding="utf-8"?>
<!-- ChoiceSheet option, the chosen one: amber edge on an amber tint. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/amber_tint">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/amber_tint" />
            <stroke android:width="1.5dp" android:color="@color/amber" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</ripple>
