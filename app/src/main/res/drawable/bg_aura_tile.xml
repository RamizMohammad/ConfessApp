<?xml version="1.0" encoding="utf-8"?>
<!-- Aura tile: transparent normally, amber plate when selected. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@drawable/bg_plate_amber" android:state_selected="true" />
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/transparent" />
            <corners android:radius="@dimen/radius_plate" />
        </shape>
    </item>
</selector>
