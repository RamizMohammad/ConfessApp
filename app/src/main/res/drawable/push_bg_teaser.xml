<?xml version="1.0" encoding="utf-8"?>
<!-- Push template "teaser" (a new confession): a paper letter with an airmail-style dashed edge. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <corners android:radius="20dp" />
    <solid android:color="@color/paper" />
    <stroke android:width="2dp" android:color="@color/amber" android:dashWidth="10dp" android:dashGap="6dp" />
</shape>
