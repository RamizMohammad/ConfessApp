<?xml version="1.0" encoding="utf-8"?>
<!-- Excerpt box inside an activity card: ink well with an amber edge on the left. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/ink" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item android:width="2dp" android:gravity="start" android:top="8dp" android:bottom="8dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/amber_disabled" />
        </shape>
    </item>
</layer-list>
