<?xml version="1.0" encoding="utf-8"?>
<!-- PostMenu opens: quick fade + grow from its corner. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@android:interpolator/decelerate_cubic">
    <alpha android:duration="140" android:fromAlpha="0" android:toAlpha="1" />
    <scale android:duration="160" android:fromXScale="0.92" android:fromYScale="0.92"
        android:pivotX="100%" android:pivotY="50%" android:toXScale="1" android:toYScale="1" />
</set>
