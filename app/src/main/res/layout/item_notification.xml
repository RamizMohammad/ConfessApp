<?xml version="1.0" encoding="utf-8"?>
<!-- One activity item: aura + badge · "@alias felt / responded…" · time · excerpt. Unread = amber edge. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card"
    android:stateListAnimator="@animator/press_scale"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/margin_screen"
    android:layout_marginVertical="5dp"
    app:cardBackgroundColor="@color/surface_raised"
    app:cardCornerRadius="@dimen/radius_plate"
    app:cardElevation="0dp"
    app:rippleColor="@color/sl_ripple_dark"
    app:strokeColor="@color/hairline"
    app:strokeWidth="@dimen/hairline">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <View
            android:id="@+id/unreadEdge"
            android:layout_width="3dp"
            android:layout_height="match_parent"
            android:background="@color/amber" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:padding="@dimen/space_md">

            <FrameLayout
                android:layout_width="44dp"
                android:layout_height="44dp">

                <in.mohammad.ramiz.confess.ui.components.AuraAvatarView
                    android:id="@+id/avatar"
                    android:layout_width="40dp"
                    android:layout_height="40dp" />

                <ImageView
                    android:id="@+id/badge"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="bottom|end"
                    android:background="@drawable/bg_notif_badge"
                    android:importantForAccessibility="no"
                    android:padding="4dp"
                    android:src="@drawable/ic_heart_filled"
                    app:tint="@color/amber" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_12"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/line"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textAppearance="@style/TextAppearance.Confess.Body"
                        android:textColor="@color/text_primary"
                        tools:text="\@nightowl_17 responded to your confession" />

                    <TextView
                        android:id="@+id/time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_sm"
                        android:layout_marginTop="3dp"
                        android:textAppearance="@style/TextAppearance.Confess.Meta"
                        android:textColor="@color/text_muted"
                        tools:text="24m ago" />
                </LinearLayout>

                <TextView
                    android:id="@+id/quote"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_quote_dark"
                    android:ellipsize="end"
                    android:fontFamily="@font/newsreader"
                    android:maxLines="3"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="10dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="16sp"
                    android:textStyle="italic"
                    tools:text="“The curtain line gave me chills…”" />

                <TextView
                    android:id="@+id/context"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.Confess.Meta"
                    android:textColor="@color/text_muted"
                    android:visibility="gone"
                    tools:text="On “Night letters left in empty stations”"
                    tools:visibility="visible" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
