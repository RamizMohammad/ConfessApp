<?xml version="1.0" encoding="utf-8"?>
<!--
    The paper confession card (S7 feed / S11 my letters / S9 detail header).
    Bound in code by the feed adapter (Section 5). Ids are the contract.
-->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card"
    android:stateListAnimator="@animator/press_scale"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/margin_screen"
    android:layout_marginVertical="@dimen/space_sm"
    android:outlineSpotShadowColor="#000000"
    android:outlineAmbientShadowColor="#000000"
    app:cardBackgroundColor="@color/paper"
    app:cardCornerRadius="@dimen/radius_card"
    app:cardElevation="@dimen/paper_elevation"
    app:rippleColor="@color/paper_rule"
    app:strokeWidth="0dp">

    <!-- Unsent letter: an airmail edge along the top of the card -->
    <View
        android:id="@+id/airmail"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_gravity="top"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/paper_padding"
        android:paddingTop="@dimen/space_md"
        android:paddingEnd="@dimen/space_sm"
        android:paddingBottom="@dimen/space_xs">

        <!-- Header: aura · @alias / time -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <in.mohammad.ramiz.confess.ui.components.AuraAvatarView
                android:id="@+id/avatar"
                android:layout_width="@dimen/avatar_sm"
                android:layout_height="@dimen/avatar_sm"
                app:aura="aura_04" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_12"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/alias"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.Confess.Alias"
                    android:textColor="@color/paper_ink"
                    tools:text="\@solitary_star" />

                <TextView
                    android:id="@+id/time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Confess.Meta"
                    android:textColor="@color/paper_meta"
                    tools:text="2h ago" />
            </LinearLayout>

            <!-- Mood: "🫂 Just listen" -->
            <TextView
                android:id="@+id/mood"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_sm"
                android:layout_marginEnd="@dimen/space_sm"
                android:background="@drawable/bg_tag_paper"
                android:maxLines="1"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:textAppearance="@style/TextAppearance.Confess.MetaSmall"
                android:textColor="@color/paper_ink"
                android:visibility="gone"
                tools:text="🫂 Just listen"
                tools:visibility="visible" />
        </LinearLayout>

        <!-- Unsent letter: "To: my dad" -->
        <TextView
            android:id="@+id/letterTo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12"
            android:drawablePadding="8dp"
            android:fontFamily="@font/newsreader"
            android:gravity="center_vertical"
            android:textColor="@color/paper_meta"
            android:textSize="17sp"
            android:textStyle="italic"
            android:visibility="gone"
            tools:text="To: my dad"
            tools:visibility="visible" />

        <!-- The confession (plain, no quote marks) -->
        <TextView
            android:id="@+id/text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12"
            android:layout_marginEnd="@dimen/space_md"
            android:ellipsize="end"
            android:maxLines="6"
            android:textAppearance="@style/TextAppearance.Confess.Confession.Card"
            android:textColor="@color/paper_ink"
            tools:text="I still look for your car at every red light, even though I moved three states away two years ago." />

        <!-- Poll: options (filled in code) + "37 votes · 2 days left" -->
        <LinearLayout
            android:id="@+id/poll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12"
            android:layout_marginEnd="@dimen/space_md"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <LinearLayout
                android:id="@+id/pollOptions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/pollMeta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:textAppearance="@style/TextAppearance.Confess.MetaSmall"
                android:textColor="@color/paper_meta"
                tools:text="37 votes · 2 days left" />
        </LinearLayout>

        <!-- Footer: felt · responses (spacing follows the counts) ·············· ⋯ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/felt"
                style="@style/Widget.Confess.Button.Ghost"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="-10dp"
                android:minWidth="0dp"
                android:minHeight="40dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:contentDescription="@string/cd_felt"
                android:textAppearance="@style/TextAppearance.Confess.Meta"
                android:textColor="@color/paper_meta"
                app:icon="@drawable/ic_heart"
                app:iconGravity="start"
                app:iconPadding="6dp"
                app:iconSize="@dimen/icon_size_sm"
                app:iconTint="@color/paper_meta"
                app:rippleColor="@android:color/transparent"
                tools:text="1.4k" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/responses"
                style="@style/Widget.Confess.Button.Ghost"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="2dp"
                android:minWidth="0dp"
                android:minHeight="40dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:contentDescription="@string/cd_responses"
                android:textAppearance="@style/TextAppearance.Confess.Meta"
                android:textColor="@color/paper_meta"
                app:icon="@drawable/ic_message"
                app:iconGravity="start"
                app:iconPadding="6dp"
                app:iconSize="@dimen/icon_size_sm"
                app:iconTint="@color/paper_meta"
                app:rippleColor="@color/paper_rule"
                tools:text="86" />

            <Space
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/more"
                style="@style/Widget.Confess.IconButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="40dp"
                android:minHeight="40dp"
                android:contentDescription="@string/cd_report_menu"
                app:icon="@drawable/ic_flag"
                app:iconSize="@dimen/icon_size_sm"
                app:iconTint="@color/paper_meta"
                app:rippleColor="@color/paper_rule" />
        </LinearLayout>
    </LinearLayout>

    <!-- Double-tap / like burst: big heart + flying sparks, drawn over the card, never touchable -->
    <FrameLayout
        android:id="@+id/burstLayer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:importantForAccessibility="no">

        <ImageView
            android:id="@+id/burst"
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_heart_filled"
            android:visibility="gone"
            app:tint="@color/amber" />
    </FrameLayout>
</com.google.android.material.card.MaterialCardView>
