<?xml version="1.0" encoding="utf-8"?>
<!-- One shimmering placeholder card (shown 3× while the first page loads). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/margin_screen"
    android:layout_marginVertical="@dimen/space_sm"
    android:background="@drawable/bg_skeleton_card"
    android:orientation="vertical"
    android:padding="@dimen/paper_padding">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <View
            android:layout_width="@dimen/avatar_sm"
            android:layout_height="@dimen/avatar_sm"
            android:background="@drawable/bg_skeleton_circle" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_12"
            android:orientation="vertical">

            <View
                android:layout_width="110dp"
                android:layout_height="10dp"
                android:background="@drawable/bg_skeleton_block" />

            <View
                android:layout_width="56dp"
                android:layout_height="8dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_skeleton_block" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="14dp"
        android:layout_marginTop="@dimen/space_md"
        android:background="@drawable/bg_skeleton_block" />

    <View
        android:layout_width="match_parent"
        android:layout_height="14dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_skeleton_block" />

    <View
        android:layout_width="180dp"
        android:layout_height="14dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_skeleton_block" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_lg"
        android:orientation="horizontal">

        <View
            android:layout_width="44dp"
            android:layout_height="10dp"
            android:background="@drawable/bg_skeleton_block" />

        <View
            android:layout_width="44dp"
            android:layout_height="10dp"
            android:layout_marginStart="@dimen/space_md"
            android:background="@drawable/bg_skeleton_block" />
    </LinearLayout>
</LinearLayout>
