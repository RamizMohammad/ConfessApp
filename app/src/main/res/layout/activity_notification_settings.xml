<?xml version="1.0" encoding="utf-8"?>
<!-- Notifications: master push switch + one switch per type (server-side), and the Android settings. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ink"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="@dimen/toolbar_height"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_xs"
        android:paddingEnd="@dimen/space_md">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/back"
            style="@style/Widget.Confess.IconButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/action_back"
            app:icon="@drawable/ic_arrow_left" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_xs"
            android:drawableStart="@drawable/dot_amber"
            android:drawablePadding="8dp"
            android:gravity="center_vertical"
            android:text="@string/nprefs_title"
            android:textAppearance="@style/TextAppearance.Confess.MetaSmall"
            android:textColor="@color/text_secondary" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false">

        <LinearLayout
            android:id="@+id/column"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/margin_screen"
            android:paddingTop="@dimen/space_sm"
            android:paddingBottom="@dimen/space_xl">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_plate"
                android:orientation="vertical">

                <include
                    android:id="@+id/master"
                    layout="@layout/view_setting_row" />
            </LinearLayout>

            <!-- This phone has Confess's sound switched off (MIUI does it to new apps): fix it here -->
            <LinearLayout
                android:id="@+id/soundWarning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:background="@drawable/bg_plate_error"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="@dimen/space_sm"
                android:paddingStart="@dimen/space_md"
                android:paddingEnd="@dimen/space_xs"
                android:visibility="gone">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/nsound_off_warning"
                    android:textAppearance="@style/TextAppearance.Confess.Meta"
                    android:textColor="@color/text_primary" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/soundFix"
                    style="@style/Widget.Confess.Button.Link"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/nsound_fix"
                    android:textColor="@color/amber" />
            </LinearLayout>

            <TextView
                style="@style/Confess.SectionLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nprefs_section_sound" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_plate"
                android:orientation="vertical">

                <include
                    android:id="@+id/sound"
                    layout="@layout/view_setting_row" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/hairline"
                    android:layout_marginStart="56dp"
                    android:background="@color/hairline" />

                <include
                    android:id="@+id/soundTest"
                    layout="@layout/view_setting_row" />
            </LinearLayout>
            <TextView
                style="@style/Confess.SectionLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nprefs_section_you" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_plate"
                android:orientation="vertical">

                <include
                    android:id="@+id/likes"
                    layout="@layout/view_setting_row" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/hairline"
                    android:layout_marginStart="56dp"
                    android:background="@color/hairline" />

                <include
                    android:id="@+id/comments"
                    layout="@layout/view_setting_row" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/hairline"
                    android:layout_marginStart="56dp"
                    android:background="@color/hairline" />

                <include
                    android:id="@+id/follows"
                    layout="@layout/view_setting_row" />
            </LinearLayout>
            <TextView
                style="@style/Confess.SectionLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nprefs_section_letters" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_plate"
                android:orientation="vertical">

                <include
                    android:id="@+id/followingPosts"
                    layout="@layout/view_setting_row" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/hairline"
                    android:layout_marginStart="56dp"
                    android:background="@color/hairline" />

                <include
                    android:id="@+id/newPosts"
                    layout="@layout/view_setting_row" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/hairline"
                    android:layout_marginStart="56dp"
                    android:background="@color/hairline" />

                <include
                    android:id="@+id/bookChapters"
                    layout="@layout/view_setting_row" />
            </LinearLayout>
            <TextView
                style="@style/Confess.SectionLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nprefs_section_other" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_plate"
                android:orientation="vertical">

                <include
                    android:id="@+id/nudges"
                    layout="@layout/view_setting_row" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/hairline"
                    android:layout_marginStart="56dp"
                    android:background="@color/hairline" />

                <include
                    android:id="@+id/system"
                    layout="@layout/view_setting_row" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:text="@string/nprefs_note"
                android:textAppearance="@style/TextAppearance.Confess.Meta"
                android:textColor="@color/text_muted" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
