<?xml version="1.0" encoding="utf-8"?>
<!-- One colour or shape in GraphStyleSheet: a little swatch + its name. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginEnd="10dp"
    android:background="@drawable/bg_row_ripple"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <FrameLayout
        android:id="@+id/frame"
        android:layout_width="76dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_banner_tile"
        android:padding="3dp">

        <in.mohammad.ramiz.confess.ui.me.GraphSwatchView
            android:id="@+id/swatch"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>

    <TextView
        android:id="@+id/name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textAppearance="@style/TextAppearance.Confess.MetaSmall"
        android:textColor="@color/text_secondary" />
</LinearLayout>
