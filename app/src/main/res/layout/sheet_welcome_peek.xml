<?xml version="1.0" encoding="utf-8"?>
<!-- Welcome → tap a note: a few sample confessions as real feed cards, then "Join the world". -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="@dimen/space_md">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/margin_screen"
        android:drawableStart="@drawable/dot_amber"
        android:drawablePadding="@dimen/space_xs"
        android:text="@string/welcome_peek_sample"
        android:textAllCaps="true"
        android:textAppearance="@style/TextAppearance.Confess.MetaSmall"
        android:textColor="@color/text_secondary" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/margin_screen"
        android:layout_marginTop="@dimen/space_xs"
        android:text="@string/welcome_peek_title"
        android:textAppearance="@style/TextAppearance.Confess.HeadlineSmall"
        android:textColor="@color/text_primary" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/margin_screen"
        android:layout_marginTop="@dimen/space_xs"
        android:text="@string/welcome_peek_sub"
        android:textAppearance="@style/TextAppearance.Confess.BodyMedium"
        android:textColor="@color/text_secondary" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/list"
        android:layout_width="match_parent"
        android:layout_height="400dp"
        android:layout_marginTop="@dimen/space_sm"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/space_sm" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/join"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/margin_screen"
        android:layout_marginTop="@dimen/space_sm"
        android:layout_marginBottom="@dimen/space_md"
        android:text="@string/welcome_join"
        app:icon="@drawable/ic_arrow_right"
        app:iconGravity="end" />
</LinearLayout>
