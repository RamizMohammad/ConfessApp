<?xml version="1.0" encoding="utf-8"?>
<!-- Books → Your books: everything I'm writing (drafts, ongoing, complete). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ink"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="@dimen/toolbar_height"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_xs"
        android:paddingEnd="@dimen/space_xs">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/back"
            style="@style/Widget.Confess.IconButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/action_back"
            app:icon="@drawable/ic_arrow_left" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_xs"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/screenTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawableStart="@drawable/dot_amber"
                android:drawablePadding="8dp"
                android:gravity="center_vertical"
                android:text="@string/mybooks_title"
                android:textAppearance="@style/TextAppearance.Confess.MetaSmall"
                android:textColor="@color/text_secondary" />

            <TextView
                android:id="@+id/screenSummary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/mybooks_summary"
                android:textAppearance="@style/TextAppearance.Confess.Meta"
                android:textColor="@color/text_muted" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/create"
            style="@style/Widget.Confess.IconButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/mybooks_new"
            app:icon="@drawable/ic_plus" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingHorizontal="@dimen/margin_screen"
            android:paddingTop="@dimen/space_sm"
            android:paddingBottom="@dimen/space_lg" />

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/progress"
            style="@style/Widget.Confess.Progress.Circular"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminate="true" />

        <LinearLayout
            android:id="@+id/state"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/space_xl"
            android:paddingBottom="@dimen/space_xl"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_icon_tile"
                android:importantForAccessibility="no"
                android:padding="16dp"
                android:src="@drawable/ic_feather"
                app:tint="@color/amber" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:gravity="center"
                android:text="@string/mybooks_empty_title"
                android:textAppearance="@style/TextAppearance.Confess.Headline"
                android:textColor="@color/text_primary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:gravity="center"
                android:text="@string/mybooks_empty_body"
                android:textAppearance="@style/TextAppearance.Confess.BodyMedium"
                android:textColor="@color/text_secondary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/createEmpty"
                style="@style/Widget.Confess.Button"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/button_height"
                android:layout_marginTop="@dimen/space_lg"
                android:paddingHorizontal="@dimen/space_lg"
                android:text="@string/mybooks_new"
                app:icon="@drawable/ic_plus"
                app:iconGravity="textStart" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
