<?xml version="1.0" encoding="utf-8"?>
<!-- One poll choice on the paper card: outline before voting; a fill bar + % after. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/row"
    android:layout_width="match_parent"
    android:layout_height="44dp"
    android:layout_marginTop="8dp"
    android:background="@drawable/bg_poll_option"
    android:foreground="@drawable/bg_row_ripple">

    <View
        android:id="@+id/fill"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_poll_fill"
        android:transformPivotX="0dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp">

        <TextView
            android:id="@+id/label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:drawablePadding="6dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.Confess.Body"
            android:textColor="@color/paper_ink"
            tools:text="Wait a week" />

        <TextView
            android:id="@+id/pct"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_sm"
            android:textAppearance="@style/TextAppearance.Confess.Meta"
            android:textColor="@color/paper_ink"
            tools:text="62%" />
    </LinearLayout>
</FrameLayout>
