<?xml version="1.0" encoding="utf-8"?>
<!-- Library (books I follow) · Updated · New. -->
<HorizontalScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="@dimen/space_md"
    android:paddingBottom="@dimen/space_sm"
    android:scrollbars="none">

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/tabs"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingHorizontal="6dp"
        app:selectionRequired="true"
        app:singleLine="true"
        app:singleSelection="true">

        <com.google.android.material.chip.Chip
            android:id="@+id/tabLibrary"
            style="@style/Widget.Confess.Chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/books_tab_library"
            app:chipIcon="@drawable/ic_library_check"
            app:chipIconSize="16dp"
            app:chipIconVisible="true" />

        <com.google.android.material.chip.Chip
            android:id="@+id/tabUpdated"
            style="@style/Widget.Confess.Chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/books_tab_updated" />

        <com.google.android.material.chip.Chip
            android:id="@+id/tabNew"
            style="@style/Widget.Confess.Chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/books_tab_new" />
    </com.google.android.material.chip.ChipGroup>
</HorizontalScrollView>
