<?xml version="1.0" encoding="utf-8"?>
<!-- Story tray bubble: ring · aura · (+ on mine) · alias. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/bubble"
    android:layout_width="72dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_row_ripple"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingVertical="4dp"
    android:stateListAnimator="@animator/press_scale">

    <FrameLayout
        android:layout_width="62dp"
        android:layout_height="62dp">

        <FrameLayout
            android:id="@+id/ring"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_story_ring_unseen"
            android:padding="5dp">

            <in.mohammad.ramiz.confess.ui.components.AuraAvatarView
                android:id="@+id/avatar"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </FrameLayout>

        <ImageView
            android:id="@+id/add"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="bottom|end"
            android:background="@drawable/bg_story_add_badge"
            android:contentDescription="@string/story_add"
            android:padding="4dp"
            android:src="@drawable/ic_plus"
            android:visibility="gone"
            app:tint="@color/paper_ink"
            tools:visibility="visible" />
    </FrameLayout>

    <TextView
        android:id="@+id/label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:textAppearance="@style/TextAppearance.Confess.MetaSmall"
        android:textColor="@color/text_secondary"
        tools:text="night_owl" />
</LinearLayout>
