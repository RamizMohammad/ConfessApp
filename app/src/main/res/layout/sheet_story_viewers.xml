<?xml version="1.0" encoding="utf-8"?>
<!-- Who saw my story: handle · "Seen by" · list (newest first). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="240dp"
    android:orientation="vertical"
    android:paddingBottom="@dimen/space_md">

    <com.google.android.material.bottomsheet.BottomSheetDragHandleView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal" />

    <TextView
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/margin_screen"
        android:textAppearance="@style/TextAppearance.Confess.HeadlineSmall"
        android:textColor="@color/text_primary"
        tools:text="Seen by 12" />

    <TextView
        android:id="@+id/empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_lg"
        android:gravity="center"
        android:paddingHorizontal="@dimen/margin_screen"
        android:textAppearance="@style/TextAppearance.Confess.Meta"
        android:textColor="@color/text_secondary"
        android:visibility="gone"
        tools:text="No views yet" />

    <ProgressBar
        android:id="@+id/loading"
        style="?android:attr/progressBarStyleSmall"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/space_lg"
        android:indeterminateTint="@color/amber" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_sm" />
</LinearLayout>
