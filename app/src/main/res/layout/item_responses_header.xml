<?xml version="1.0" encoding="utf-8"?>
<!-- "• RESPONSES (86)                OLDEST FIRST" -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="@dimen/margin_screen"
    android:paddingTop="@dimen/space_lg"
    android:paddingBottom="@dimen/space_12">

    <TextView
        android:id="@+id/title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:drawableStart="@drawable/dot_amber"
        android:drawablePadding="10dp"
        android:gravity="center_vertical"
        android:textAppearance="@style/TextAppearance.Confess.MetaSmall"
        android:textColor="@color/amber"
        tools:text="RESPONSES (86)" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/detail_responses_order"
        android:textAppearance="@style/TextAppearance.Confess.MetaSmall"
        android:textColor="@color/text_muted" />
</LinearLayout>
