<?xml version="1.0" encoding="utf-8"?>
<!-- S1 · Welcome — headline, stacked paper notes, "Join the world". -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_welcome"
    android:paddingHorizontal="@dimen/margin_screen">

    <!-- Wordmark + live clock -->
    <TextView
        android:id="@+id/wordmark"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_md"
        android:drawableEnd="@drawable/dot_amber"
        android:drawablePadding="6dp"
        android:text="@string/app_name"
        android:textAppearance="@style/TextAppearance.Confess.HeadlineSmall"
        android:textStyle="italic"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextClock
        android:id="@+id/clock"
        style="@style/Confess.Tag"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:format12Hour="hh:mm a"
        android:format24Hour="HH:mm"
        android:textColor="@color/text_primary"
        android:textAllCaps="true"
        app:layout_constraintBottom_toBottomOf="@id/wordmark"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/wordmark" />

    <!-- Headline -->
    <TextView
        android:id="@+id/headline1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_xl"
        android:text="@string/tagline_line1"
        android:textAppearance="@style/TextAppearance.Confess.Display"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/wordmark" />

    <TextView
        android:id="@+id/headline2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/tagline_line2"
        android:textAppearance="@style/TextAppearance.Confess.Display"
        android:textColor="@color/amber"
        android:textStyle="italic"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headline1" />

    <TextView
        android:id="@+id/sub"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_md"
        android:text="@string/tagline_sub"
        android:textAppearance="@style/TextAppearance.Confess.Body"
        android:textColor="@color/text_secondary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headline2" />

    <!-- Stacked notes (filled + rotated in code) -->
    <FrameLayout
        android:id="@+id/noteStack"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        app:layout_constraintBottom_toTopOf="@id/join"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/sub" />

    <!-- Actions -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/join"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_md"
        android:text="@string/welcome_join"
        app:icon="@drawable/ic_arrow_right"
        app:layout_constraintBottom_toTopOf="@id/footer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/footer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/welcome_footer"
        android:textAppearance="@style/TextAppearance.Confess.Meta"
        android:textColor="@color/text_muted"
        app:layout_constraintBottom_toTopOf="@id/haveAccount"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/haveAccount"
        style="@style/Widget.Confess.Button.Ghost"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_sm"
        android:text="@string/welcome_have_account"
        android:textColor="@color/text_primary"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
