<?xml version="1.0" encoding="utf-8"?>
<!-- S4 · Choose your alias (+ optional password lock / biometric). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ink"
    android:orientation="vertical">

    <include
        android:id="@+id/stepBar"
        layout="@layout/view_step_bar" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:animateLayoutChanges="true"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/margin_screen"
            android:paddingTop="@dimen/space_md"
            android:paddingBottom="@dimen/space_lg">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/alias_title"
                android:textAppearance="@style/TextAppearance.Confess.Headline" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:text="@string/alias_subtitle"
                android:textAppearance="@style/TextAppearance.Confess.Body"
                android:textColor="@color/text_secondary" />

            <!-- Alias field card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:background="@drawable/bg_plate"
                android:orientation="vertical"
                android:padding="@dimen/space_md">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/alias_label"
                    android:textAppearance="@style/TextAppearance.Confess.MetaSmall"
                    android:textColor="@color/text_muted" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/aliasLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    app:counterEnabled="true"
                    app:counterMaxLength="15"
                    app:endIconMode="clear_text"
                    app:endIconTint="@color/text_muted"
                    app:prefixText="\@"
                    app:prefixTextColor="@color/amber">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/aliasInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/alias_hint"
                        android:imeOptions="actionDone"
                        android:importantForAutofill="no"
                        android:inputType="textNoSuggestions|textVisiblePassword"
                        android:maxLength="15"
                        android:singleLine="true" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:id="@+id/aliasStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:background="@drawable/bg_status_pill"
                    android:drawablePadding="6dp"
                    android:paddingHorizontal="@dimen/space_12"
                    android:paddingVertical="6dp"
                    android:text="@string/alias_rules"
                    android:textAppearance="@style/TextAppearance.Confess.Meta"
                    android:textColor="@color/text_muted" />

                <!-- Why it's not allowed (wording check) -->
                <TextView
                    android:id="@+id/aliasReason"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:textAppearance="@style/TextAppearance.Confess.Meta"
                    android:textColor="@color/text_secondary"
                    android:visibility="gone" />

                <!-- Taken → free variations from the server -->
                <LinearLayout
                    android:id="@+id/freePanel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/alias_free_title"
                        android:textAppearance="@style/TextAppearance.Confess.MetaSmall"
                        android:textColor="@color/sage" />

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/freeSuggestions"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12"
                android:text="@string/alias_permanent"
                android:textAppearance="@style/TextAppearance.Confess.Meta"
                android:textColor="@color/text_secondary" />

            <!-- Suggestions -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/alias_suggestions"
                    android:textAppearance="@style/TextAppearance.Confess.MetaSmall"
                    android:textColor="@color/text_muted" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/shuffle"
                    style="@style/Widget.Confess.Button.Link"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/alias_shuffle"
                    android:textAppearance="@style/TextAppearance.Confess.Meta"
                    app:icon="@drawable/ic_shuffle"
                    app:iconGravity="textStart"
                    app:iconSize="@dimen/icon_size_sm" />
            </LinearLayout>

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/suggestions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <!-- Password lock -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:animateLayoutChanges="true"
                android:background="@drawable/bg_plate"
                android:orientation="vertical"
                android:padding="@dimen/space_md">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_icon_tile"
                        android:importantForAccessibility="no"
                        android:padding="10dp"
                        android:src="@drawable/ic_lock"
                        app:tint="@color/amber" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="@dimen/space_md"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/lock_title"
                            android:textAppearance="@style/TextAppearance.Confess.Label" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/lock_subtitle"
                            android:textAppearance="@style/TextAppearance.Confess.Meta"
                            android:textColor="@color/text_muted" />
                    </LinearLayout>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/lockSwitch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:contentDescription="@string/lock_title" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/lockPanel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/passwordLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:endIconDrawable="@drawable/sel_password_toggle"
                        app:endIconMode="password_toggle">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/passwordInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/lock_hint"
                            android:importantForAutofill="no"
                            android:inputType="textPassword"
                            android:maxLength="64"
                            android:singleLine="true" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Strength meter -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_sm"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <View
                            android:id="@+id/seg1"
                            android:layout_width="28dp"
                            android:layout_height="4dp"
                            android:background="@drawable/strength_segment" />

                        <View
                            android:id="@+id/seg2"
                            android:layout_width="28dp"
                            android:layout_height="4dp"
                            android:layout_marginStart="4dp"
                            android:background="@drawable/strength_segment" />

                        <View
                            android:id="@+id/seg3"
                            android:layout_width="28dp"
                            android:layout_height="4dp"
                            android:layout_marginStart="4dp"
                            android:background="@drawable/strength_segment" />

                        <TextView
                            android:id="@+id/strengthText"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_sm"
                            android:layout_weight="1"
                            android:textAppearance="@style/TextAppearance.Confess.Meta"
                            android:textColor="@color/text_muted" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/lock_min"
                            android:textAppearance="@style/TextAppearance.Confess.Meta"
                            android:textColor="@color/text_muted" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_sm"
                        android:text="@string/lock_helper"
                        android:textAppearance="@style/TextAppearance.Confess.Meta"
                        android:textColor="@color/text_secondary" />

                    <!-- Biometric (only if the phone supports it) -->
                    <LinearLayout
                        android:id="@+id/bioRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_md"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:visibility="gone">

                        <ImageView
                            android:layout_width="@dimen/icon_size"
                            android:layout_height="@dimen/icon_size"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_fingerprint"
                            app:tint="@color/text_secondary" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="@dimen/space_md"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/bio_title"
                                android:textAppearance="@style/TextAppearance.Confess.Label" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/bio_subtitle"
                                android:textAppearance="@style/TextAppearance.Confess.Meta"
                                android:textColor="@color/text_muted" />
                        </LinearLayout>

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/bioSwitch"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:contentDescription="@string/bio_title" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Sticky action -->
    <FrameLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/margin_screen"
        android:paddingTop="@dimen/space_sm"
        android:paddingBottom="@dimen/space_md">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/next"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:enabled="false"
            android:text="@string/alias_next"
            app:icon="@drawable/ic_arrow_right" />
    </FrameLayout>
</LinearLayout>
