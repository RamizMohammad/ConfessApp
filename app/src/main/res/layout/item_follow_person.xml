<?xml version="1.0" encoding="utf-8"?>
<!-- Followers / following row: aura · @alias · about · Follow / Following. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_row_ripple"
    android:gravity="center_vertical"
    android:minHeight="64dp"
    android:orientation="horizontal"
    android:paddingHorizontal="@dimen/margin_screen"
    android:paddingVertical="@dimen/space_12">

    <in.mohammad.ramiz.confess.ui.components.AuraAvatarView
        android:id="@+id/avatar"
        android:layout_width="@dimen/avatar_md"
        android:layout_height="@dimen/avatar_md" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_md"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/alias"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.Confess.Alias"
            android:textColor="@color/text_primary"
            tools:text="\@moonlit_echo" />

        <TextView
            android:id="@+id/about"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:fontFamily="@font/newsreader"
            android:maxLines="1"
            android:textColor="@color/text_secondary"
            android:textSize="15sp"
            android:textStyle="italic"
            tools:text="Night owl. Bad at goodbyes." />
    </LinearLayout>

    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_sm">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/followBtn"
            style="@style/Widget.Confess.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:minHeight="36dp"
            android:paddingHorizontal="14dp"
            android:text="@string/follow"
            android:textAppearance="@style/TextAppearance.Confess.Meta" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/followingBtn"
            style="@style/Widget.Confess.Button.Outlined"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:minHeight="36dp"
            android:paddingHorizontal="14dp"
            android:text="@string/following_btn"
            android:textAppearance="@style/TextAppearance.Confess.Meta"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
