<?xml version="1.0" encoding="utf-8"?>
<!--
    A book's page (like an e-book store / library entry): cover, title, writer, blurb,
    Start / Continue reading, Add to library, then the contents.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ink"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="@dimen/toolbar_height"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_xs"
        android:paddingEnd="@dimen/space_xs">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/back"
            style="@style/Widget.Confess.IconButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/action_back"
            app:icon="@drawable/ic_arrow_left" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/more"
            style="@style/Widget.Confess.IconButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/action_more"
            app:icon="@drawable/ic_more" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/scroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:visibility="invisible"
            tools:visibility="visible">

            <LinearLayout
                android:id="@+id/column"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/margin_screen"
                android:paddingBottom="@dimen/space_xl">

                <in.mohammad.ramiz.confess.ui.books.BookCoverView
                    android:id="@+id/cover"
                    android:layout_width="148dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="@dimen/space_sm"
                    android:elevation="12dp" />

                <TextView
                    android:id="@+id/title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_lg"
                    android:gravity="center"
                    android:textAppearance="@style/TextAppearance.Confess.Headline"
                    android:textColor="@color/text_primary"
                    tools:text="The year I left home" />

                <LinearLayout
                    android:id="@+id/authorRow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="@dimen/space_sm"
                    android:background="@drawable/bg_row_ripple"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/space_xs">

                    <in.mohammad.ramiz.confess.ui.components.AuraAvatarView
                        android:id="@+id/avatar"
                        android:layout_width="@dimen/avatar_xs"
                        android:layout_height="@dimen/avatar_xs" />

                    <TextView
                        android:id="@+id/alias"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_sm"
                        android:textAppearance="@style/TextAppearance.Confess.Alias"
                        android:textColor="@color/text_secondary"
                        tools:text="\@mira" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="@dimen/space_12"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/status"
                        style="@style/Confess.Tag"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="ONGOING" />

                    <TextView
                        android:id="@+id/stats"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_sm"
                        android:textAppearance="@style/TextAppearance.Confess.Meta"
                        android:textColor="@color/text_muted"
                        tools:text="8 chapters · 23 in libraries" />
                </LinearLayout>

                <TextView
                    android:id="@+id/blurb"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    android:fontFamily="@font/newsreader"
                    android:gravity="center"
                    android:lineSpacingExtra="4sp"
                    android:textColor="@color/text_secondary"
                    android:textSize="16sp"
                    android:textStyle="italic"
                    tools:text="Twelve months, one city, and every letter I never sent." />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/read"
                    style="@style/Widget.Confess.Button"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/button_height"
                    android:layout_marginTop="@dimen/space_lg"
                    app:icon="@drawable/ic_book_open"
                    app:iconGravity="textStart"
                    tools:text="Continue · Chapter 3" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/library"
                    style="@style/Widget.Confess.Button.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/button_height"
                    android:layout_marginTop="@dimen/space_sm"
                    app:iconGravity="textStart"
                    tools:text="Add to library" />

                <TextView
                    android:id="@+id/hiddenNote"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    android:background="@drawable/bg_plate_error"
                    android:padding="@dimen/space_12"
                    android:text="@string/desk_hidden"
                    android:textAppearance="@style/TextAppearance.Confess.BodyMedium"
                    android:textColor="@color/text_primary"
                    android:visibility="gone" />

                <TextView
                    style="@style/Confess.SectionLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingTop="@dimen/space_32"
                    android:text="@string/book_contents" />

                <LinearLayout
                    android:id="@+id/contents"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_plate"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/noChapters"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/space_md"
                    android:text="@string/book_no_chapters"
                    android:textAppearance="@style/TextAppearance.Confess.BodyMedium"
                    android:textColor="@color/text_muted"
                    android:visibility="gone" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/progress"
            style="@style/Widget.Confess.Progress.Circular"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminate="true" />

        <TextView
            android:id="@+id/error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:padding="@dimen/space_xl"
            android:textAppearance="@style/TextAppearance.Confess.Body"
            android:textColor="@color/text_secondary"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
