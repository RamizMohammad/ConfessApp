<?xml version="1.0" encoding="utf-8"?>
<!-- One aura in the S5 collection grid. Selected → bg_plate_amber + check badge. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/tile"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="5dp"
    android:background="@drawable/bg_aura_tile"
    android:foreground="@drawable/bg_row_ripple"
    android:paddingVertical="@dimen/space_12">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <in.mohammad.ramiz.confess.ui.components.AuraAvatarView
            android:id="@+id/aura"
            android:layout_width="64dp"
            android:layout_height="64dp" />

        <TextView
            android:id="@+id/label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:textAppearance="@style/TextAppearance.Confess.Meta"
            android:textColor="@color/text_secondary" />
    </LinearLayout>

    <ImageView
        android:id="@+id/check"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_gravity="top|end"
        android:layout_margin="6dp"
        android:background="@drawable/bg_check_badge"
        android:importantForAccessibility="no"
        android:padding="3dp"
        android:src="@drawable/ic_check"
        android:visibility="gone"
        app:tint="@color/paper_ink" />
</FrameLayout>
