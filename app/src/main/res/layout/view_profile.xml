<?xml version="1.0" encoding="utf-8"?>
<!-- Shared by the Me tab and someone's profile: top bar · list (header + letters) · states. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="@dimen/toolbar_height"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_xs"
        android:paddingEnd="@dimen/space_xs">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/back"
            style="@style/Widget.Confess.IconButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/action_back"
            android:visibility="gone"
            app:icon="@drawable/ic_arrow_left"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/tag"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_md"
            android:layout_weight="1"
            android:drawableStart="@drawable/dot_amber"
            android:drawablePadding="8dp"
            android:gravity="center_vertical"
            android:textAppearance="@style/TextAppearance.Confess.MetaSmall"
            android:textColor="@color/text_secondary"
            tools:text="YOUR PROFILE" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/action"
            style="@style/Widget.Confess.IconButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/cd_settings"
            android:visibility="gone"
            app:icon="@drawable/ic_settings"
            tools:visibility="visible" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/refresh"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:overScrollMode="never" />
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        <com.facebook.shimmer.ShimmerFrameLayout
            android:id="@+id/skeleton"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            app:shimmer_auto_start="false"
            app:shimmer_base_alpha="0.6"
            app:shimmer_duration="1400"
            app:shimmer_highlight_alpha="1.0">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingTop="@dimen/space_md">

                <View
                    android:layout_width="112dp"
                    android:layout_height="112dp"
                    android:background="@drawable/bg_skeleton_circle" />

                <View
                    android:layout_width="160dp"
                    android:layout_height="18dp"
                    android:layout_marginTop="@dimen/space_md"
                    android:background="@drawable/bg_skeleton_block" />

                <View
                    android:layout_width="220dp"
                    android:layout_height="12dp"
                    android:layout_marginTop="@dimen/space_sm"
                    android:background="@drawable/bg_skeleton_block" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="96dp"
                    android:layout_marginHorizontal="@dimen/margin_screen"
                    android:layout_marginTop="@dimen/space_lg"
                    android:background="@drawable/bg_skeleton_card" />

                <include layout="@layout/item_feed_skeleton" />
            </LinearLayout>
        </com.facebook.shimmer.ShimmerFrameLayout>

        <LinearLayout
            android:id="@+id/state"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/space_xl"
            android:paddingBottom="@dimen/space_xl"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageView
                android:id="@+id/stateIcon"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_icon_tile"
                android:importantForAccessibility="no"
                android:padding="16dp"
                android:src="@drawable/ic_user"
                app:tint="@color/amber" />

            <TextView
                android:id="@+id/stateTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:gravity="center"
                android:textAppearance="@style/TextAppearance.Confess.HeadlineSmall"
                android:textColor="@color/text_primary" />

            <TextView
                android:id="@+id/stateBody"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:gravity="center"
                android:textAppearance="@style/TextAppearance.Confess.BodyMedium"
                android:textColor="@color/text_secondary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/stateAction"
                style="@style/Widget.Confess.Button.Outlined"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:paddingHorizontal="@dimen/space_lg" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
