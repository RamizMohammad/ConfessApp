<?xml version="1.0" encoding="utf-8"?>
<!-- New story: one coloured card, a line or two of text (≤ 100), pick a background, share for 24 h. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ink">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Top bar: close · counter -->
        <FrameLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/toolbar_height"
            android:paddingHorizontal="@dimen/space_sm">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/close"
                style="@style/Widget.Confess.IconButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start|center_vertical"
                android:contentDescription="@string/cd_story_close"
                app:icon="@drawable/ic_close" />

            <TextView
                android:id="@+id/counter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="@dimen/space_md"
                android:textAppearance="@style/TextAppearance.Confess.Meta"
                android:textColor="@color/text_secondary" />
        </FrameLayout>

        <!-- The card -->
        <FrameLayout
            android:id="@+id/card"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginHorizontal="@dimen/space_md"
            android:layout_weight="1">

            <EditText
                android:id="@+id/input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:background="@null"
                android:fontFamily="@font/newsreader"
                android:gravity="center"
                android:hint="@string/story_compose_hint"
                android:importantForAutofill="no"
                android:inputType="textMultiLine|textCapSentences"
                android:lineSpacingExtra="6sp"
                android:maxLength="100"
                android:maxLines="4"
                android:padding="@dimen/space_lg"
                android:textSize="28sp"
                android:textStyle="italic" />
        </FrameLayout>

        <!-- Backgrounds -->
        <LinearLayout
            android:id="@+id/swatches"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/space_md"
            android:orientation="horizontal" />

        <TextView
            android:id="@+id/error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/margin_screen"
            android:layout_marginTop="@dimen/space_sm"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.Confess.BodyMedium"
            android:textColor="@color/brick"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/bottom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/margin_screen"
            android:paddingTop="@dimen/space_md"
            android:paddingBottom="@dimen/space_md">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/share"
                style="@style/Widget.Confess.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:enabled="false"
                android:text="@string/story_share"
                app:icon="@drawable/ic_send"
                app:iconGravity="textStart" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
