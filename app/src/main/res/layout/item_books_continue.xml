<?xml version="1.0" encoding="utf-8"?>
<!-- Shelf header: the books I'm in the middle of (positions saved on this phone). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="@dimen/space_xs">

    <TextView
        style="@style/Confess.SectionLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="6dp"
        android:paddingTop="@dimen/space_sm"
        android:text="@string/books_continue" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:nestedScrollingEnabled="false"
        android:overScrollMode="never"
        android:paddingEnd="6dp" />
</LinearLayout>
