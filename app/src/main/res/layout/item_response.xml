<?xml version="1.0" encoding="utf-8"?>
<!-- One response: dark card with a stripe in the writer's aura colour. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/margin_screen"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="@color/surface_raised"
    app:cardCornerRadius="@dimen/radius_plate"
    app:cardElevation="0dp"
    app:strokeColor="@color/hairline"
    app:strokeWidth="@dimen/hairline">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <View
            android:id="@+id/stripe"
            android:layout_width="3dp"
            android:layout_height="match_parent"
            android:background="@color/amber" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="@dimen/space_md"
            android:paddingTop="@dimen/space_12"
            android:paddingEnd="@dimen/space_xs"
            android:paddingBottom="@dimen/space_md">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="40dp"
                android:orientation="horizontal">

                <in.mohammad.ramiz.confess.ui.components.AuraAvatarView
                    android:id="@+id/avatar"
                    android:layout_width="@dimen/avatar_xs"
                    android:layout_height="@dimen/avatar_xs" />

                <TextView
                    android:id="@+id/alias"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.Confess.Alias"
                    android:textColor="@color/text_primary"
                    tools:text="\@driftwood_soul" />

                <TextView
                    android:id="@+id/authorTag"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_author_tag"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="1dp"
                    android:text="@string/response_author"
                    android:textAppearance="@style/TextAppearance.Confess.MetaSmall"
                    android:textColor="@color/amber"
                    android:textSize="9sp"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/time"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.Confess.Meta"
                    android:textColor="@color/text_muted"
                    tools:text="1h ago" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/more"
                    style="@style/Widget.Confess.IconButton"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:contentDescription="@string/action_more"
                    android:minWidth="40dp"
                    android:minHeight="40dp"
                    android:visibility="gone"
                    app:icon="@drawable/ic_more"
                    app:iconSize="@dimen/icon_size_sm"
                    app:iconTint="@color/text_muted"
                    tools:visibility="visible" />
            </LinearLayout>

            <TextView
                android:id="@+id/text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginEnd="@dimen/space_12"
                android:textAppearance="@style/TextAppearance.Confess.Body"
                android:textColor="@color/text_primary"
                android:textIsSelectable="true"
                tools:text="The curtain line gave me chills. Keep buying things they hated." />

            <!-- A GIF response (GIPHY) — with or without words. -->
            <in.mohammad.ramiz.confess.ui.components.AspectImageView
                android:id="@+id/gif"
                android:layout_width="200dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="4dp"
                android:background="@color/surface_high"
                android:scaleType="centerCrop"
                android:visibility="gone"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Confess.Gif" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
