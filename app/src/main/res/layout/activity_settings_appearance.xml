<?xml version="1.0" encoding="utf-8"?>
<!-- Settings → Appearance: paper + text tone (cards, composer, book pages) and how bursts look. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ink"
    android:orientation="vertical">

    <FrameLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/toolbar_height"
        android:paddingHorizontal="@dimen/space_sm">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/back"
            style="@style/Widget.Confess.IconButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start|center_vertical"
            android:contentDescription="@string/action_back"
            app:icon="@drawable/ic_arrow_left" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:fontFamily="@font/newsreader"
            android:text="@string/settings_appearance_title"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:textStyle="italic" />
    </FrameLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/margin_screen"
            android:paddingBottom="@dimen/space_xl">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:text="@string/settings_appearance_intro"
                android:textAppearance="@style/TextAppearance.Confess.BodyMedium"
                android:textColor="@color/text_secondary" />

            <TextView
                style="@style/Confess.SectionLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_section_paper" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_plate"
                android:orientation="vertical"
                android:padding="@dimen/space_md">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/paper_tone"
                    android:textAppearance="@style/TextAppearance.Confess.Body"
                    android:textColor="@color/text_primary" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/paper_tone_sub"
                    android:textAppearance="@style/TextAppearance.Confess.Meta"
                    android:textColor="@color/text_secondary" />

                <!-- Live preview: a little paper note at the chosen tone -->
                <TextView
                    android:id="@+id/tonePreview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_12"
                    android:background="@drawable/bg_paper"
                    android:fontFamily="@font/newsreader"
                    android:padding="@dimen/space_md"
                    android:text="@string/paper_tone_preview"
                    android:textColor="@color/paper_ink"
                    android:textSize="16sp"
                    android:textStyle="italic" />

                <LinearLayout
                    android:layout_marginTop="@dimen/space_sm"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:contentDescription="@string/cd_paper_light"
                        android:src="@drawable/dot_paper_light" />

                    <com.google.android.material.slider.Slider
                        android:id="@+id/paperTone"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="@dimen/space_xs"
                        android:layout_weight="1"
                        android:contentDescription="@string/paper_tone"
                        android:stepSize="5"
                        android:value="0"
                        android:valueFrom="0"
                        android:valueTo="100"
                        app:labelBehavior="gone" />

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:contentDescription="@string/cd_paper_grey"
                        android:src="@drawable/dot_paper_grey" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/text_tone"
                        android:textAppearance="@style/TextAppearance.Confess.Body"
                        android:textColor="@color/text_primary" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/textAuto"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="@string/text_tone_auto"
                        android:textAppearance="@style/TextAppearance.Confess.Meta"
                        android:textColor="@color/text_secondary" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:contentDescription="@string/cd_text_dark"
                        android:src="@drawable/dot_text_dark" />

                    <com.google.android.material.slider.Slider
                        android:id="@+id/textTone"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="@dimen/space_xs"
                        android:layout_weight="1"
                        android:contentDescription="@string/text_tone"
                        android:stepSize="5"
                        android:value="0"
                        android:valueFrom="0"
                        android:valueTo="100"
                        app:labelBehavior="gone" />

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:contentDescription="@string/cd_text_light"
                        android:src="@drawable/dot_text_light" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                style="@style/Confess.SectionLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_bursts" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_plate"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/space_md"
                android:paddingVertical="@dimen/space_sm">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/space_sm"
                    android:text="@string/settings_bursts_sub"
                    android:textAppearance="@style/TextAppearance.Confess.Meta"
                    android:textColor="@color/text_secondary" />

                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/burstMode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:selectionRequired="true"
                    app:singleSelection="true">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/burstSlider"
                        style="@style/Widget.Confess.Button.Outlined"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:maxLines="1"
                        android:text="@string/burst_mode_slider" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/burstStack"
                        style="@style/Widget.Confess.Button.Outlined"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:maxLines="1"
                        android:text="@string/burst_mode_stack" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/burstSeparate"
                        style="@style/Widget.Confess.Button.Outlined"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:maxLines="1"
                        android:text="@string/burst_mode_separate" />
                </com.google.android.material.button.MaterialButtonToggleGroup>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/burstHow"
                    style="@style/Widget.Confess.Button.Link"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_bursts_how"
                    app:icon="@drawable/ic_arrow_right"
                    app:iconGravity="end" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
