<?xml version="1.0" encoding="utf-8"?>
<!-- One number inside a Me card: "GIVEN 12". -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_weight="1"
    android:background="@drawable/bg_stat_cell"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/space_12"
    android:paddingVertical="10dp">

    <TextView
        android:id="@+id/label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.Confess.MetaSmall"
        android:textColor="@color/text_muted"
        tools:text="RECEIVED" />

    <TextView
        android:id="@+id/value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textAppearance="@style/TextAppearance.Confess.HeadlineSmall"
        android:textColor="@color/text_primary"
        tools:text="382" />
</LinearLayout>
