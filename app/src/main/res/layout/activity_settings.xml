<?xml version="1.0" encoding="utf-8"?>
<!-- S12 · Settings. Old: the button grid in ProfileFragment (+ UpdatePassBio). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ink"
    android:orientation="vertical">

    <FrameLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/toolbar_height"
        android:paddingHorizontal="@dimen/space_sm">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/back"
            style="@style/Widget.Confess.IconButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start|center_vertical"
            android:contentDescription="@string/action_back"
            app:icon="@drawable/ic_arrow_left" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:fontFamily="@font/newsreader"
            android:text="@string/settings_title"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:textStyle="italic" />
    </FrameLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/margin_screen"
            android:paddingBottom="@dimen/space_xl">

            <TextView
                style="@style/Confess.Tag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:background="@null"
                android:drawableStart="@drawable/dot_amber"
                android:paddingStart="0dp"
                android:text="@string/settings_tag" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:text="@string/settings_headline"
                android:textAppearance="@style/TextAppearance.Confess.Headline"
                android:textColor="@color/text_primary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:text="@string/settings_sub"
                android:textAppearance="@style/TextAppearance.Confess.BodyMedium"
                android:textColor="@color/text_secondary" />

            <TextView
                style="@style/Confess.SectionLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_section_security" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_plate"
                android:orientation="vertical">

                <include
                    android:id="@+id/lock"
                    layout="@layout/view_setting_row" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/hairline"
                    android:layout_marginStart="56dp"
                    android:background="@color/hairline" />

                <include
                    android:id="@+id/autolock"
                    layout="@layout/view_setting_row" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/hairline"
                    android:layout_marginStart="56dp"
                    android:background="@color/hairline" />

                <include
                    android:id="@+id/bio"
                    layout="@layout/view_setting_row" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/hairline"
                    android:layout_marginStart="56dp"
                    android:background="@color/hairline" />

                <include
                    android:id="@+id/changePassword"
                    layout="@layout/view_setting_row" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/hairline"
                    android:layout_marginStart="56dp"
                    android:background="@color/hairline" />

                <include
                    android:id="@+id/privacyScreen"
                    layout="@layout/view_setting_row" />

            </LinearLayout>

            <TextView
                style="@style/Confess.SectionLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_section_notifications" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_plate"
                android:orientation="vertical">

                <include
                    android:id="@+id/push"
                    layout="@layout/view_setting_row" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/hairline"
                    android:layout_marginStart="56dp"
                    android:background="@color/hairline" />

                <include
                    android:id="@+id/pushSystem"
                    layout="@layout/view_setting_row" />

            </LinearLayout>

            <TextView
                style="@style/Confess.SectionLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_section_profile" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_plate"
                android:orientation="vertical">

                <include
                    android:id="@+id/editProfile"
                    layout="@layout/view_setting_row" />

            </LinearLayout>

            <TextView
                style="@style/Confess.SectionLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_section_support" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_plate"
                android:orientation="vertical">

                <include
                    android:id="@+id/feature"
                    layout="@layout/view_setting_row" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/hairline"
                    android:layout_marginStart="56dp"
                    android:background="@color/hairline" />

                <include
                    android:id="@+id/guidelines"
                    layout="@layout/view_setting_row" />


            </LinearLayout>

            <TextView
                style="@style/Confess.SectionLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_section_account" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_plate"
                android:orientation="vertical">

                <include
                    android:id="@+id/signOut"
                    layout="@layout/view_setting_row" />

            </LinearLayout>

            <!-- Debug builds only -->
            <LinearLayout
                android:id="@+id/designGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12"
                android:background="@drawable/bg_plate"
                android:orientation="vertical"
                android:visibility="gone">

                <include
                    android:id="@+id/design"
                    layout="@layout/view_setting_row" />
            </LinearLayout>

            <!-- Danger zone -->
            <TextView
                style="@style/Confess.SectionLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_danger"
                android:textColor="@color/brick" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_plate_error"
                android:orientation="vertical"
                android:padding="@dimen/space_md">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_icon_tile"
                        android:importantForAccessibility="no"
                        android:padding="10dp"
                        android:src="@drawable/ic_trash"
                        app:tint="@color/brick" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_md"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/settings_delete_title"
                            android:textAppearance="@style/TextAppearance.Confess.Body"
                            android:textColor="@color/brick" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/settings_delete_body"
                            android:textAppearance="@style/TextAppearance.Confess.BodyMedium"
                            android:textColor="@color/text_secondary" />
                    </LinearLayout>
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/deleteAccount"
                    style="@style/Widget.Confess.Button.Danger"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    android:text="@string/settings_delete_button"
                    app:icon="@drawable/ic_trash"
                    app:iconGravity="textStart" />
            </LinearLayout>

            <TextView
                android:id="@+id/version"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:gravity="center"
                android:textAppearance="@style/TextAppearance.Confess.MetaSmall"
                android:textColor="@color/text_muted" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
