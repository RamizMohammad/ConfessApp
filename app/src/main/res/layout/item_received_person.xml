<?xml version="1.0" encoding="utf-8"?>
<!-- Someone who felt a letter (child row under an expanded letter). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="36dp"
    android:layout_marginEnd="@dimen/margin_screen"
    android:background="@drawable/bg_row_ripple"
    android:gravity="center_vertical"
    android:minHeight="52dp"
    android:orientation="horizontal"
    android:paddingHorizontal="@dimen/space_sm"
    android:paddingVertical="6dp">

    <in.mohammad.ramiz.confess.ui.components.AuraAvatarView
        android:id="@+id/avatar"
        android:layout_width="@dimen/avatar_sm"
        android:layout_height="@dimen/avatar_sm" />

    <TextView
        android:id="@+id/alias"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_12"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:textAppearance="@style/TextAppearance.Confess.Alias"
        android:textColor="@color/text_primary"
        tools:text="\@driftwood_soul" />

    <TextView
        android:id="@+id/time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.Confess.Meta"
        android:textColor="@color/text_muted"
        tools:text="1h ago" />
</LinearLayout>
