<?xml version="1.0" encoding="utf-8"?>
<!-- Home bottom bar: Feed · (Confess) · Me. The centre button is a raised amber circle. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_bar"
    android:baselineAligned="false"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:gravity="bottom"
    android:orientation="horizontal"
    android:paddingTop="@dimen/space_xs">

    <LinearLayout
        android:id="@+id/tabFeed"
        android:layout_width="0dp"
        android:layout_height="@dimen/bottom_nav_height"
        android:layout_weight="1"
        android:background="@drawable/bg_row_ripple"
        android:contentDescription="@string/tab_feed"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/iconFeed"
            android:layout_width="@dimen/icon_size"
            android:layout_height="@dimen/icon_size"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_letters" />

        <TextView
            android:id="@+id/labelFeed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/tab_feed"
            android:textAppearance="@style/TextAppearance.Confess.MetaSmall" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingBottom="8dp">

        <ImageButton
            android:id="@+id/compose"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginTop="-22dp"
            android:background="@drawable/bg_compose_button"
            android:contentDescription="@string/cd_compose"
            android:elevation="8dp"
            android:outlineAmbientShadowColor="@color/amber"
            android:outlineSpotShadowColor="@color/amber"
            android:src="@drawable/ic_compose"
            app:tint="@color/paper_ink" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/tab_confess"
            android:textAppearance="@style/TextAppearance.Confess.MetaSmall"
            android:textColor="@color/amber" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/tabMe"
        android:layout_width="0dp"
        android:layout_height="@dimen/bottom_nav_height"
        android:layout_weight="1"
        android:background="@drawable/bg_row_ripple"
        android:contentDescription="@string/tab_me"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/iconMe"
            android:layout_width="@dimen/icon_size"
            android:layout_height="@dimen/icon_size"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_user" />

        <TextView
            android:id="@+id/labelMe"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/tab_me"
            android:textAppearance="@style/TextAppearance.Confess.MetaSmall" />
    </LinearLayout>
</LinearLayout>
