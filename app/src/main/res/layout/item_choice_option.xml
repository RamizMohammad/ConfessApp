<?xml version="1.0" encoding="utf-8"?>
<!-- One ChoiceSheet option: icon tile · title / line · check. Selected = amber edge + tint (in code). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_sm"
    android:background="@drawable/bg_choice_option"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="64dp"
    android:orientation="horizontal"
    android:paddingHorizontal="@dimen/space_md"
    android:paddingVertical="@dimen/space_12">

    <FrameLayout
        android:id="@+id/tile"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_icon_tile">

        <ImageView
            android:id="@+id/icon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            app:tint="@color/text_secondary"
            tools:src="@drawable/ic_bell" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_md"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Confess.Body"
            android:textColor="@color/text_primary"
            tools:text="Phone's default" />

        <TextView
            android:id="@+id/sub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textAppearance="@style/TextAppearance.Confess.Meta"
            android:textColor="@color/text_muted"
            android:visibility="gone"
            tools:text="Whatever your phone uses"
            tools:visibility="visible" />
    </LinearLayout>

    <ImageView
        android:id="@+id/check"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_marginStart="@dimen/space_sm"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_check"
        android:visibility="invisible"
        app:tint="@color/amber" />
</LinearLayout>
